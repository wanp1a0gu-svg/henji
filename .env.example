# ============================================================================
# 痕迹 Traces · 部署环境变量清单
# ============================================================================
# 用法：把本文件复制成 .env（本地）或在 Railway/Render 的 Variables 面板逐条填入。
# .env 已在 .gitignore 里，不会被提交。
#
# 取值来源：
#   · 支付 / 邮件 / 模型密钥 → 本机 server-config.json（同名 key）
#   · Supabase → Supabase 项目 Settings → API
# ============================================================================

# --- 站点 ---------------------------------------------------------------
PORT=3000

# --- Supabase（前端构建期注入，必须以 NEXT_PUBLIC_ 开头） -----------------
# 区域建议 Singapore / US West；换成海外区域是这次迁移的核心目的
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- PayPal --------------------------------------------------------------
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_EVENTS_TOKEN=

# --- 邮件（订单通知 / 命书发送） ------------------------------------------
MAIL_PROVIDER=smtp
MAIL_FROM=
MAIL_FROM_NAME=Traces
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- 对话模型（小痕已下线，恢复对话时才会用到） ---------------------------
CHAT_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
CHAT_FALLBACKS=glm-4-flash-250414,glm-4.7-flash
CHAT_REASONING_EFFORT=low

# --- 钱包签名密钥 --------------------------------------------------------
# 必须与数据库 app_secrets.wallet_secret 完全一致，否则充值/消费验签全失败
WALLET_RECHARGE_SECRET=

# --- 后台退款令牌 --------------------------------------------------------
ADMIN_REFUND_TOKEN=
